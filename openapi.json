components:
  schemas:
    Achievement:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          title: 제목
          maxLength: 100
        description:
          type: string
          title: 설명
        badge:
          type: string
          title: 배지
          maxLength: 50
        achieved_at:
          type: string
          format: date-time
          readOnly: true
          title: 달성 시각
        shared_to_ai:
          type: boolean
          title: AI 공유 여부
        user:
          type: integer
          title: 사용자
        daily_goal:
          type: integer
          nullable: true
          title: 연계 일일 목표
      required:
      - achieved_at
      - id
      - title
      - user
    DailyGoal:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
          readOnly: true
        date:
          type: string
          format: date
          title: 날짜
        kcal_target:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          nullable: true
          title: 목표 열량(kcal)
        protein_target_g:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          nullable: true
          title: 목표 단백질(g)
        workout_minutes_target:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          nullable: true
          title: 목표 운동 시간(분)
        completion_score:
          type: number
          format: double
          nullable: true
          title: 달성도 점수(%)
        goal:
          type: integer
          title: 목표
      required:
      - date
      - goal
      - id
      - user
    DailyReport:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        date:
          type: string
          format: date
          title: 날짜
        summary:
          type: string
          title: 요약
        highlights:
          type: string
          title: 하이라이트
        challenges:
          type: string
          title: 과제
        mood:
          allOf:
          - $ref: '#/components/schemas/MoodEnum'
          title: 기분
        score:
          type: number
          format: double
          nullable: true
          title: AI 점수
        source:
          allOf:
          - $ref: '#/components/schemas/DailyReportSourceEnum'
          title: 생성 출처
        ai_model:
          type: string
          title: AI 모델
          maxLength: 100
        ai_response:
          nullable: true
          title: AI 응답
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: 생성일
        updated_at:
          type: string
          format: date-time
          readOnly: true
          title: 수정일
        user:
          type: integer
          title: 사용자
      required:
      - created_at
      - date
      - id
      - updated_at
      - user
    DailyReportSourceEnum:
      enum:
      - user
      - device
      - ai
      type: string
      description: |-
        * `user` - User
        * `device` - Device
        * `ai` - AI
    Exercise:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        target:
          type: string
          title: 대상 부위
          maxLength: 50
        name:
          type: string
          title: 이름
          maxLength: 100
        description:
