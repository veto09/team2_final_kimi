      - password
      - refresh
      - username
    TokenRefresh:
      type: object
      properties:
        access:
          type: string
          readOnly: true
        refresh:
          type: string
          writeOnly: true
      required:
      - access
      - refresh
    TokenVerify:
      type: object
      properties:
        token:
          type: string
          writeOnly: true
      required:
      - token
    User:
      type: object
      description: |-
        유저 기본 직렬화기
        - username/id는 읽기전용 (아이디 변경 방지)
        - is_active는 일반 PATCH로는 수정 불가(휴면/복구는 별도 액션에서 처리)
      properties:
        id:
          type: integer
          readOnly: true
        username:
          type: string
          readOnly: true
          title: 아이디
          description: 로그인에 사용할 아이디 (영문, 숫자 조합)
        email:
          type: string
          format: email
          title: 이메일
          description: 연락용 이메일 주소
          maxLength: 254
        first_name:
          type: string
          title: 이름
          maxLength: 150
        last_name:
          type: string
          title: 성
          maxLength: 150
        is_active:
          type: boolean
          readOnly: true
          title: 활성
          description: 이 사용자가 활성화되어 있는지를 나타냅니다. 계정을 삭제하는 대신 이것을 선택 해제하세요.
        date_joined:
          type: string
          format: date-time
          readOnly: true
          title: 등록일
      required:
      - date_joined
      - email
      - id
      - is_active
      - username
    WorkoutLog:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
          readOnly: true
          title: 사용자
        workout_plan:
          type: integer
          nullable: true
          title: 연계 운동 계획
        task_item:
          type: integer
          nullable: true
          title: 연계 작업
        exercise:
          type: integer
          title: 운동
        exercise_name:
          type: string
          title: 이름
          readOnly: true
        date:
          type: string
          format: date
          title: 날짜
        duration_min:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          title: 운동 시간(분)
        kcal_burned:
          type: number
          format: double
          title: 소모 칼로리
        perceived_exertion:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          title: 체감 강도
        ai_adjusted:
          type: boolean
          title: AI 조정 여부
        notes:
          type: string
          title: 메모
      required:
      - date
      - exercise
      - exercise_name
      - id
      - user
    WorkoutPlan:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
          readOnly: true
          title: 사용자
        title:
          type: string
          title: 제목
          maxLength: 100
        description:
          type: string
          title: 설명
        summary:
          type: string
          title: 요약
        target_focus:
          type: string
          title: 중점 영역
          maxLength: 50
        source:
          allOf:
          - $ref: '#/components/schemas/WorkoutPlanSourceEnum'
          title: 생성 출처
        ai_model:
          type: string
          title: AI 모델
          maxLength: 100
        ai_version:
          type: string
          title: AI 버전
          maxLength: 50
        ai_prompt:
          type: string
          title: AI 프롬프트
        ai_response:
          nullable: true
          title: AI 응답
        ai_confidence:
          type: number
          format: double
          nullable: true
          title: AI 신뢰도
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: 생성일
        updated_at:
          type: string
          format: date-time
          readOnly: true
          title: 수정일
        tasks:
          type: string
          readOnly: true
        tasks_count:
          type: integer
          readOnly: true
        total_duration_min:
          type: integer
          readOnly: true
      required:
      - created_at
      - id
      - tasks
      - tasks_count
      - title
      - total_duration_min
      - updated_at
      - user
    WorkoutPlanSourceEnum:
      enum:
      - manual
      - ai_initial
      - ai_update
      type: string
      description: |-
        * `manual` - Manual
        * `ai_initial` - AI Initial
        * `ai_update` - AI Update
  securitySchemes:
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
